pkgbase = moss-terminal
	pkgdesc = AI-native terminal built on kitty: ask by typing 》 at the prompt, answers stream into the terminal itself
	pkgver = 0.1.0
	pkgrel = 1
	url = https://github.com/Moritz230127/Moss-Terminal
	install = moss-terminal.install
	arch = x86_64
	arch = aarch64
	license = GPL-3.0-only
	license = MIT
	makedepends = rust
	makedepends = go
	makedepends = python
	makedepends = pkgconf
	makedepends = wayland-protocols
	makedepends = libxrandr
	makedepends = libxinerama
	makedepends = simde
	makedepends = patch
	depends = cairo
	depends = dbus
	depends = freetype2
	depends = fontconfig
	depends = harfbuzz
	depends = hicolor-icon-theme
	depends = lcms2
	depends = libgl
	depends = libpng
	depends = librsync
	depends = libx11
	depends = libxcursor
	depends = libxkbcommon
	depends = libxkbcommon-x11
	depends = libxi
	depends = openssl
	depends = python3
	depends = wayland
	depends = xxhash
	depends = zlib
	depends = kitty-terminfo
	depends = alsa-lib
	optdepends = imagemagick: viewing images with icat (run /usr/lib/moss-terminal/bin/kitten icat)
	optdepends = python-pygments: syntax highlighting in kitten diff
	optdepends = libcanberra: playing "bell" sound on terminal bell
	optdepends = zsh: full-fidelity 》 input (recommended over bash, see the post-install note)
	optdepends = fish: full-fidelity 》 input (recommended over bash, see the post-install note)
	options = !lto
	source = moss-terminal-0.1.0.tar.gz::https://github.com/Moritz230127/Moss-Terminal/releases/download/v0.1.0/moss-terminal-0.1.0.tar.gz
